local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local VIS_ATTR = "SPWN_ManagedVisibility"

local function ReadPersistedVisibility(gui, fallback)
    if gui then
        local v = gui:GetAttribute(VIS_ATTR)
        if v ~= nil then return v end
    end
    if fallback ~= nil then return fallback end
    return true
end

local function WritePersistedVisibility(gui, value)
    if gui then
        pcall(function() gui:SetAttribute(VIS_ATTR, value) end)
    end
end

local function ApplyGuiVisibility(gui, visible)
    if not gui then return end
    local openBtn = gui:FindFirstChild("OpenToggleButton", true)
    if openBtn then
        openBtn.Visible = visible
        openBtn.Active = visible
    end
end

local function ResetState()
    RegisteredScripts = {}
    UIListFrame = nil
    SearchBox = nil
    MainFrame = nil
    ScreenGuiRef = nil
    IsDestroyed = true
end

local function RefreshList()
    if not UIListFrame or IsDestroyed then return end
    if not UIListFrame.Parent then return end

    -- Limpa a lista atual
    for _, child in ipairs(UIListFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local toRemove = {}
    for id, data in pairs(RegisteredScripts) do
        -- Se o GuiObject não existir mais ou não tiver um Parent válido, marca para remover
        if not data.GuiObject or not data.GuiObject.Parent then
            table.insert(toRemove, id)
        end
    end
    for _, id in ipairs(toRemove) do
        RegisteredScripts[id] = nil
    end

    local filterText = SearchBox and string.lower(SearchBox.Text) or ""
    local filteredList = {}

    for id, data in pairs(RegisteredScripts) do
        if data.GuiObject and data.GuiObject.Parent then
            local nameLower = string.lower(data.Name or "")
            local catLower = string.lower(data.Category or "")
            
            local matches = false
            local matchScore = 0

            if filterText == "" then
                matches = true
            else
                local nameStart = string.find(nameLower, filterText, 1, true)
                if nameStart then
                    matches = true
                    if nameStart == 1 then matchScore = 100 else matchScore = 50 end
                end
                if not matches and string.find(catLower, filterText, 1, true) then
                    matches = true
                    matchScore = 10
                end
            end

            if matches then
                table.insert(filteredList, {id = id, data = data, score = matchScore})
            end
        end
    end

    table.sort(filteredList, function(a, b)
        return a.score > b.score
    end)

    for index, item in ipairs(filteredList) do
        local id = item.id
        local data = item.data

        local ItemFrame = Instance.new("Frame")
        ItemFrame.Size = UDim2.new(1, -6, 0, 34) 
        ItemFrame.Position = UDim2.new(0, 3, 0, 0)
        ItemFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
        -- [CORREÇÃO VISUAL] Removemos a borda padrão do Frame para o Stroke agir sozinho
        ItemFrame.BorderSizePixel = 0 
        ItemFrame.Parent = UIListFrame

        -- [CORREÇÃO VISUAL] Stroke aplicado de forma limpa
        local UIStroke = Instance.new("UIStroke")
        UIStroke.Color = Color3.fromRGB(50, 50, 60)
        UIStroke.Thickness = 1
        UIStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border -- Desenha a borda por dentro
        UIStroke.Parent = ItemFrame

        -- Destaque de pesquisa (Borda branca brilhante)
        if index == 1 and filterText ~= "" then
            UIStroke.Color = Color3.fromRGB(255, 255, 255)
            UIStroke.Thickness = 2
        end

        local ItemSun = Instance.new("ImageLabel")
        ItemSun.Size = UDim2.new(0, 14, 0, 14)
        ItemSun.Position = UDim2.new(0, 6, 0.5, -7)
        ItemSun.BackgroundTransparency = 1
        ItemSun.Image = "rbxassetid://77667780640343"
        ItemSun.Parent = ItemFrame

        local TextsHolder = Instance.new("Frame")
        TextsHolder.Size = UDim2.new(0.55, -24, 1, 0)
        TextsHolder.Position = UDim2.new(0, 26, 0, 0)
        TextsHolder.BackgroundTransparency = 1
        TextsHolder.Parent = ItemFrame

        local NameLabel = Instance.new("TextLabel")
        NameLabel.Size = UDim2.new(1, 0, 0, 16)
        NameLabel.Position = UDim2.new(0, 0, 0, 2)
        NameLabel.BackgroundTransparency = 1
        NameLabel.Text = data.Name or id
        NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        NameLabel.Font = Enum.Font.GothamBold 
        NameLabel.TextSize = 10
        NameLabel.TextXAlignment = Enum.TextXAlignment.Left
        NameLabel.TextTruncate = Enum.TextTruncate.AtEnd
        NameLabel.Parent = TextsHolder

        local SubLabel = Instance.new("TextLabel")
        SubLabel.Size = UDim2.new(1, 0, 0, 12)
        SubLabel.Position = UDim2.new(0, 0, 0, 17)
        SubLabel.BackgroundTransparency = 1
        SubLabel.Text = data.Category or "SPWN"
        SubLabel.TextColor3 = Color3.fromRGB(130, 130, 140)
        SubLabel.Font = Enum.Font.Gotham
        SubLabel.TextSize = 8
        SubLabel.TextXAlignment = Enum.TextXAlignment.Left
        SubLabel.TextTruncate = Enum.TextTruncate.AtEnd
        SubLabel.Parent = TextsHolder

        local ToggleBtn = Instance.new("TextButton")
        ToggleBtn.Size = UDim2.new(0, 50, 0, 20)
        ToggleBtn.Position = UDim2.new(1, -56, 0.5, -10)
        ToggleBtn.Font = Enum.Font.GothamBold
        ToggleBtn.TextSize = 9
        ToggleBtn.BorderSizePixel = 0
        -- [CORREÇÃO VISUAL] Impede que o botão "vaze" para fora da moldura
        ToggleBtn.ClipsDescendants = true 

        local BtnCorner = Instance.new("UICorner")
        BtnCorner.CornerRadius = UDim.new(1, 0)
        BtnCorner.Parent = ToggleBtn

        local function updateToggleVisual()
            if data.IsVisible then
                ToggleBtn.Text = "Visível"
                ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                ToggleBtn.TextColor3 = Color3.fromRGB(10, 10, 12)
                
                if not (index == 1 and filterText ~= "") then
                    UIStroke.Color = Color3.fromRGB(50, 50, 60)
                end
            else
                ToggleBtn.Text = "Oculto"
                ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
                
                -- [CORREÇÃO VISUAL] Força a borda do ItemFrame a ficar branca e fina
                UIStroke.Color = Color3.fromRGB(255, 255, 255)
                UIStroke.Thickness = 1.5
                
                local stroke = ToggleBtn:FindFirstChildOfClass("UIStroke")
                if not stroke then
                    stroke = Instance.new("UIStroke", ToggleBtn)
                    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                end
                stroke.Color = Color3.fromRGB(100, 100, 110)
                stroke.Thickness = 1
            end
        end

        updateToggleVisual()

        ToggleBtn.MouseButton1Click:Connect(function()
            data.IsVisible = not data.IsVisible
            WritePersistedVisibility(data.GuiObject, data.IsVisible)
            ApplyGuiVisibility(data.GuiObject, data.IsVisible)
            updateToggleVisual()
        end)
        ToggleBtn.Parent = ItemFrame

        local lastClick = 0
        ItemFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                local now = os.clock()
                if now - lastClick < 0.35 then
                    local cid = id
                    task.defer(function()
                        local entry = RegisteredScripts[cid]
                        if entry then
                            if entry.OnDestroy then pcall(entry.OnDestroy) end
                            if entry.GuiObject then entry.GuiObject:Destroy() end
                            RegisteredScripts[cid] = nil
                        end
                        RefreshList()
                    end)
                end
                lastClick = now
            end
        end)
    end
end

