--[[
    Script Manager - SPWN (Versão Definitiva com Detecção por Atributos de Memória)
    Posicionado 10% mais acima e resistente a fechamentos/reexecuções.
--]]

local ScriptManager = {}
ScriptManager.__index = ScriptManager

local RegisteredScripts = {}
local UIListFrame = nil
local SearchBox = nil
local MainFrame = nil
local ScreenGuiRef = nil

local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

