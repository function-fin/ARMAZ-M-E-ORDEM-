    end

    -- Janela Principal (Tamanho Compacto Ideal para Mobile)
    MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 210, 0, 240)
    MainFrame.Position = UDim2.new(0.5, -105, 0.5, -120)
