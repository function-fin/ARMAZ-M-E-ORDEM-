--[[
    Script Manager - SPWN (Versão Vertical com Título Super Destacado)
    Design Retro com Prioridade Máxima de DisplayOrder
--]]

local ScriptManager = {}
ScriptManager.__index = ScriptManager

local RegisteredScripts = {}
local UIListFrame = nil
local SearchBox = nil
local MainFrame = nil
local ScreenGuiRef = nil

local function CreateManagerUI()
    local CoreGui = game:GetService("CoreGui")
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local UserInputService = game:GetService("UserInputService")

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ScriptManager_SPWN"
    ScreenGui.ResetOnSpawn = false
    -- GARANTINDO PRIORIDADE MÁXIMA SOBRE O SCRIPT PRINCIPAL
    ScreenGui.DisplayOrder = 999999 
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    pcall(function()
        ScreenGui.Parent = CoreGui
    end)
    if not ScreenGui.Parent then
        ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
    ScreenGuiRef = ScreenGui

    -- Janela Principal (Formato Retangular Vertical Compacto)
    MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 220, 0, 350)
    MainFrame.Position = UDim2.new(0.5, -110, 0.5, -175)
    MainFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
    MainFrame.BorderSizePixel = 2
    MainFrame.BorderColor3 = Color3.fromRGB(255, 255, 255) -- Borda Branca Sólida
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.ZIndex = 10 -- Garante que os elementos internos fiquem organizados em cima
    MainFrame.Parent = ScreenGui

    -- Topo / Cabeçalho com Título Ampliado e Destacado
    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 46)
    TopBar.BackgroundTransparency = 1
    TopBar.ZIndex = 11
    TopBar.Parent = MainFrame

    local SunIcon = Instance.new("ImageLabel")
    SunIcon.Size = UDim2.new(0, 26, 0, 26)
    SunIcon.Position = UDim2.new(0, 10, 0.5, -13)
    SunIcon.BackgroundTransparency = 1
    SunIcon.Image = "rbxassetid://77667780640343"
    SunIcon.ZIndex = 11
    SunIcon.Parent = TopBar

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, -42, 1, 0)
    TitleLabel.Position = UDim2.new(0, 40, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = "CLOSE AND OPEN | SPWN"
    TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleLabel.Font = Enum.Font.Arcade
    TitleLabel.TextSize = 12
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.ZIndex = 11
    TitleLabel.Parent = TopBar

    -- Linha Divisória Branca Abaixo do Título
    local TopDivider = Instance.new("Frame")
    TopDivider.Size = UDim2.new(1, 0, 0, 1)
    TopDivider.Position = UDim2.new(0, 0, 0, 46)
    TopDivider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    TopDivider.BorderSizePixel = 0
    TopDivider.ZIndex = 11
    TopDivider.Parent = MainFrame

    -- Container da Barra de Pesquisa
    local SearchContainer = Instance.new("Frame")
    SearchContainer.Size = UDim2.new(1, -16, 0, 28)
    SearchContainer.Position = UDim2.new(0, 8, 0, 54)
    SearchContainer.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
    SearchContainer.BorderSizePixel = 1
    SearchContainer.BorderColor3 = Color3.fromRGB(255, 255, 255)
    SearchContainer.ZIndex = 11
    SearchContainer.Parent = MainFrame

    local SearchIcon = Instance.new("ImageLabel")
    SearchIcon.Size = UDim2.new(0, 14, 0, 14)
    SearchIcon.Position = UDim2.new(0, 6, 0.5, -7)
    SearchIcon.BackgroundTransparency = 1
    SearchIcon.Image = "rbxassetid://84375270553103"
    SearchIcon.ZIndex = 12
    SearchIcon.Parent = SearchContainer

    SearchBox = Instance.new("TextBox")
    SearchBox.Size = UDim2.new(1, -26, 1, 0)
    SearchBox.Position = UDim2.new(0, 24, 0, 0)
    SearchBox.BackgroundTransparency = 1
    SearchBox.Text = ""
    SearchBox.PlaceholderText = "Buscar scripts..."
    SearchBox.PlaceholderColor3 = Color3.fromRGB(130, 130, 140)
    SearchBox.TextColor3 = Color3.fromRGB(240, 240, 240)
    SearchBox.Font = Enum.Font.Arcade
    SearchBox.TextSize = 10
    SearchBox.TextXAlignment = Enum.TextXAlignment.Left
    SearchBox.ZIndex = 12
    SearchBox.Parent = SearchContainer

    -- Linha Divisória Branca Abaixo da Pesquisa
    local SearchDivider = Instance.new("Frame")
    SearchDivider.Size = UDim2.new(1, 0, 0, 1)
    SearchDivider.Position = UDim2.new(0, 0, 0, 88)
    SearchDivider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    SearchDivider.BorderSizePixel = 0
    SearchDivider.ZIndex = 11
    SearchDivider.Parent = MainFrame

    -- Container Scrollável da Lista
    local Scroll = Instance.new("ScrollingFrame")
    Scroll.Size = UDim2.new(1, -8, 1, -94)
    Scroll.Position = UDim2.new(0, 4, 0, 91)
    Scroll.BackgroundTransparency = 1
    Scroll.BorderSizePixel = 0
    Scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Scroll.ScrollBarThickness = 2
    Scroll.ZIndex = 11
    Scroll.Parent = MainFrame

    local UIList = Instance.new("UIListLayout")
    UIList.Padding = UDim.new(0, 4)
    UIList.SortOrder = Enum.SortOrder.LayoutOrder
    UIList.Parent = Scroll

    UIListFrame = Scroll

    -- Sistema de Fechar ao Clicar Fora (Oculta o painel sem reiniciar o script)
    UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if MainFrame and MainFrame.Visible then
                local mousePos = UserInputService:GetMouseLocation()
                local absPos = MainFrame.AbsolutePosition
                local absSize = MainFrame.AbsoluteSize

                if mousePos.X < absPos.X or mousePos.X > absPos.X + absSize.X or
                   mousePos.Y < absPos.Y or mousePos.Y > absPos.Y + absSize.Y then
                    MainFrame.Visible = false
                end
            end
        end
    end)
end

-- Renderização dos Itens da Lista
local function RefreshList()
    if not UIListFrame then return end

    for _, child in pairs(UIListFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local filterText = SearchBox and string.lower(SearchBox.Text) or ""

    for id, data in pairs(RegisteredScripts) do
        local matchesFilter = (filterText == "") or string.find(string.lower(data.Name), filterText) or string.find(string.lower(data.Category or ""), filterText)

        if matchesFilter then
            local ItemFrame = Instance.new("Frame")
            ItemFrame.Size = UDim2.new(1, 0, 0, 40)
            ItemFrame.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
            ItemFrame.BorderSizePixel = 1
            ItemFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
            ItemFrame.ZIndex = 12
            ItemFrame.Parent = UIListFrame

            -- Ícone de Sol do Item
            local ItemSun = Instance.new("ImageLabel")
            ItemSun.Size = UDim2.new(0, 16, 0, 16)
            ItemSun.Position = UDim2.new(0, 8, 0.5, -8)
            ItemSun.BackgroundTransparency = 1
            ItemSun.Image = "rbxassetid://77667780640343"
            ItemSun.ZIndex = 13
            ItemSun.Parent = ItemFrame

            -- Textos (Nome + Subtítulo)
            local TextsHolder = Instance.new("Frame")
            TextsHolder.Size = UDim2.new(0.55, -28, 1, 0)
            TextsHolder.Position = UDim2.new(0, 28, 0, 0)
            TextsHolder.BackgroundTransparency = 1
            TextsHolder.ZIndex = 13
            TextsHolder.Parent = ItemFrame

            local NameLabel = Instance.new("TextLabel")
            NameLabel.Size = UDim2.new(1, 0, 0, 20)
            NameLabel.Position = UDim2.new(0, 0, 0, 4)
            NameLabel.BackgroundTransparency = 1
            NameLabel.Text = data.Name
            NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            NameLabel.Font = Enum.Font.Arcade
            NameLabel.TextSize = 10
            NameLabel.TextXAlignment = Enum.TextXAlignment.Left
            NameLabel.TextTruncate = Enum.TextTruncate.AtEnd
            NameLabel.ZIndex = 13
            NameLabel.Parent = TextsHolder

            local SubLabel = Instance.new("TextLabel")
            SubLabel.Size = UDim2.new(1, 0, 0, 14)
            SubLabel.Position = UDim2.new(0, 0, 0, 20)
            SubLabel.BackgroundTransparency = 1
            SubLabel.Text = data.Category or "SPWN"
            SubLabel.TextColor3 = Color3.fromRGB(150, 150, 160)
            SubLabel.Font = Enum.Font.Arcade
            SubLabel.TextSize = 8
            SubLabel.TextXAlignment = Enum.TextXAlignment.Left
            SubLabel.TextTruncate = Enum.TextTruncate.AtEnd
            SubLabel.ZIndex = 13
            SubLabel.Parent = TextsHolder

            -- Botão Pílula (Visível / Oculto)
            local ToggleBtn = Instance.new("TextButton")
            ToggleBtn.Size = UDim2.new(0, 54, 0, 20)
            ToggleBtn.Position = UDim2.new(1, -60, 0.5, -10)
            ToggleBtn.Font = Enum.Font.Arcade
            ToggleBtn.TextSize = 9
            ToggleBtn.BorderSizePixel = 1
            ToggleBtn.ZIndex = 13

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(1, 0)
            BtnCorner.Parent = ToggleBtn

            local function updateToggleVisual()
                if data.IsVisible then
                    ToggleBtn.Text = "Visível"
                    ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    ToggleBtn.BorderColor3 = Color3.fromRGB(255, 255, 255)
                    ToggleBtn.TextColor3 = Color3.fromRGB(10, 10, 12)
                else
                    ToggleBtn.Text = "Oculto"
                    ToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
                    ToggleBtn.BorderColor3 = Color3.fromRGB(150, 150, 160)
                    ToggleBtn.TextColor3 = Color3.fromRGB(150, 150, 160)
                end
            end

            updateToggleVisual()

            ToggleBtn.MouseButton1Click:Connect(function()
                data.IsVisible = not data.IsVisible
                
                if data.GuiObject and data.GuiObject:FindFirstChild("OpenToggleButton") then
                    local openBtn = data.GuiObject.OpenToggleButton
                    openBtn.Visible = data.IsVisible
                    openBtn.Active = data.IsVisible
                end
                
                updateToggleVisual()
            end)
            ToggleBtn.Parent = ItemFrame

            -- Duplo Clique para Encerrar o Script Completamente
            local lastClick = 0
            ItemFrame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local now = tick()
                    if now - lastClick < 0.35 then
                        if data.OnDestroy then
                            data.OnDestroy()
                        end
                        if data.GuiObject then
                            data.GuiObject:Destroy()
                        end
                        RegisteredScripts[id] = nil
                        RefreshList()
                    end
                    lastClick = now
                end
            end)
        end
    end
end

task.spawn(function()
    repeat task.wait() until SearchBox
    SearchBox:GetPropertyChangedSignal("Text"):Connect(RefreshList)
end)

function ScriptManager.RegisterScript(id, config)
    RegisteredScripts[id] = {
        Name = config.Name or id,
        Category = config.Category or "SPWN",
        GuiObject = config.GuiObject,
        IsVisible = true,
        OnDestroy = config.OnDestroy
    }
    RefreshList()
end

function ScriptManager.UnregisterScript(id)
    if RegisteredScripts[id] then
        RegisteredScripts[id] = nil
        RefreshList()
    end
end

CreateManagerUI()
_G.ScriptManager = ScriptManager
return ScriptManager
