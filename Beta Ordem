    Script Manager - SPWN (Versão Corrigida para Ocultar Apenas o Botão Flutuante)
    Design Retro com Bordas Brancas, Linhas Divisórias e Ícones Personalizados
--]]

local ScriptManager = {}
ScriptManager.__index = ScriptManager

local RegisteredScripts = {}
local UIListFrame = nil
local SearchBox = nil
local MainFrame = nil

