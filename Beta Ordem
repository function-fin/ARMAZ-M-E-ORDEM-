    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 220, 0, 350)
    MainFrame.Position = UDim2.new(0.5, -110, 0.4, -175)
    MainFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
    MainFrame.BorderSizePixel = 2
    MainFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Parent = ScreenGui

    -- Topo / Cabeçalho
    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 46)
    TopBar.BackgroundTransparency = 1
    TopBar.Parent = MainFrame

    local SunIcon = Instance.new("ImageLabel")
    SunIcon.Size = UDim2.new(0, 22, 0, 22)
    SunIcon.Position = UDim2.new(0, 10, 0.5, -11)
    SunIcon.BackgroundTransparency = 1
    SunIcon.Image = "rbxassetid://77667780640343"
    SunIcon.Parent = TopBar

    local TitleLabel = Instance.new("TextLabel")
