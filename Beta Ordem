-- =========================================================
-- API de registro (usada por scripts adaptados que rodam DEPOIS)
-- =========================================================
function ScriptManager.RegisterScript(id, config)
    if IsDestroyed then
        _G.ScriptManagerQueue = _G.ScriptManagerQueue or {}
        table.insert(_G.ScriptManagerQueue, { id = id, config = config })
        return
    end

    local gui = config.GuiObject
    -- [NOVO] Lê visibilidade persistida (sobrevive a fechar/reabrir)
    local isVisible = ReadPersistedVisibility(gui, true)

    RegisteredScripts[id] = {
        Name = config.Name or id,
        Category = config.Category or "SPWN",
        GuiObject = gui,
        IsVisible = isVisible,
        OnDestroy = config.OnDestroy,
    }

    -- [NOVO] Reaplica visibilidade real na GUI
    ApplyGuiVisibility(gui, isVisible)

    RefreshList()
end

-- =========================================================
-- Setup
-- =========================================================
local function CleanupPreviousInstances()
    pcall(function()
        local g = CoreGui:FindFirstChild("ScriptManager_SPWN")
        if g then g:Destroy() end
    end)
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            local g = pg:FindFirstChild("ScriptManager_SPWN")
            if g then g:Destroy() end
        end
    end)
end

CleanupPreviousInstances()

ResetState()
CreateManagerUI()

_G.ScriptManager = ScriptManager

-- =========================================================
-- Varredura periódica
-- =========================================================
task.spawn(function()
    while not IsDestroyed do
        local needsRefresh = false

        -- 1) Consome a fila global — só remove se registrar com sucesso
        local queue = _G.ScriptManagerQueue
        if queue and type(queue) == "table" then
            for i = #queue, 1, -1 do
                local reg = queue[i]
                if reg and reg.config and reg.config.GuiObject and reg.config.GuiObject.Parent then
                    local gui = reg.config.GuiObject
                    -- [NOVO] Lê visibilidade persistida
                    local isVisible = ReadPersistedVisibility(gui, true)

                    RegisteredScripts[reg.id] = {
                        Name = reg.config.Name or reg.id,
                        Category = reg.config.Category or "SPWN",
                        GuiObject = gui,
                        IsVisible = isVisible,
                        OnDestroy = reg.config.OnDestroy,
                    }
                    -- [NOVO] Reaplica visibilidade real
                    ApplyGuiVisibility(gui, isVisible)

                    table.remove(queue, i)
                    needsRefresh = true
                end
            end
        end

        -- 2) Varredura por atributos (recursiva)
        pcall(function()
            local containers = { CoreGui, LocalPlayer:FindFirstChild("PlayerGui") }
            for _, container in ipairs(containers) do
                if container then
                    for _, gui in ipairs(container:GetDescendants()) do
                        local sId = gui:GetAttribute("SPWN_ManagedScriptID")
                        if sId and (gui:IsA("ScreenGui") or gui:IsA("Folder")) then
                            local sName = gui:GetAttribute("SPWN_ManagedScriptName") or sId
                            local sCat  = gui:GetAttribute("SPWN_ManagedScriptCategory") or "SPWN"

                            local existing = RegisteredScripts[sId]
                            if not existing
                                or existing.GuiObject ~= gui
                                or not existing.GuiObject
                                or not existing.GuiObject.Parent then

                                -- [NOVO] Lê visibilidade persistida do atributo
                                local isVisible = ReadPersistedVisibility(
                                    gui,
                                    existing and existing.IsVisible or nil
                                )

                                RegisteredScripts[sId] = {
                                    Name = sName,
                                    Category = sCat,
                                    GuiObject = gui,
                                    IsVisible = isVisible,
                                    OnDestroy = existing and existing.OnDestroy or nil,
                                }
                                -- [NOVO] Reaplica visibilidade real na GUI
                                ApplyGuiVisibility(gui, isVisible)

                                needsRefresh = true
                            end
                        end
                    end
                end
            end
        end)

        if needsRefresh then
            RefreshList()
        end

        task.wait(0.4)
    end
end)

return ScriptManager