--[[
    Script Manager - SPWN (Versão Definitiva - UI Melhorada)
    - Design baseado na 2ª imagem (Barra de título grande, Glow, Scroll customizado)
    - Pesquisa Inteligente (Ranking de resultados por relevância)
    - Arrastável (Draggable)
    - Reset total ao fechar (X) ou reexecutar
    - Reconexão automática com scripts adaptados ao reabrir
    - Varredura por atributos em CoreGui e PlayerGui (recursiva)
    - [NOVO] Persistência de visibilidade via atributo na GUI adaptada
--]]

local ScriptManager = {}
ScriptManager.__index = ScriptManager

-- Estado do módulo (reatribuível para reset limpo)
local RegisteredScripts = {}
local UIListFrame = nil
local SearchBox = nil
local MainFrame = nil
local ScreenGuiRef = nil
local IsDestroyed = false

local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- =========================================================
-- [NOVO] Helpers de visibilidade persistente
-- =========================================================
local VIS_ATTR = "SPWN_ManagedVisibility"

local function ReadPersistedVisibility(gui, fallback)
    if gui then
        local v = gui:GetAttribute(VIS_ATTR)
        if v ~= nil then return v end
    end
    if fallback ~= nil then return fallback end
    return true
end

local function WritePersistedVisibility(gui, value)
    if gui then
        pcall(function() gui:SetAttribute(VIS_ATTR, value) end)
    end
end

local function ApplyGuiVisibility(gui, visible)
    if not gui then return end
    local openBtn = gui:FindFirstChild("OpenToggleButton", true)
    if openBtn then
        openBtn.Visible = visible
        openBtn.Active = visible
    end
end

-- =========================================================
-- Reset global de estado
-- =========================================================
local function ResetState()
    RegisteredScripts = {}
    UIListFrame = nil
    SearchBox = nil
    MainFrame = nil
    ScreenGuiRef = nil
    IsDestroyed = true
end

-- =========================================================
-- Render da lista (Com Pesquisa Inteligente e Novo Design)
-- =========================================================
local function RefreshList()
    if not UIListFrame or IsDestroyed then return end
    if not UIListFrame.Parent then return end

    -- Limpa a lista atual
    for _, child in ipairs(UIListFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    -- Coleta entradas mortas ANTES de iterar
    local toRemove = {}
    for id, data in pairs(RegisteredScripts) do
        if not (data.GuiObject and data.GuiObject.Parent) then
            table.insert(toRemove, id)
        end
    end
    for _, id in ipairs(toRemove) do
        RegisteredScripts[id] = nil
    end

    local filterText = SearchBox and string.lower(SearchBox.Text) or ""
    local results = {}

    -- Coleta e pontua os resultados (Pesquisa Inteligente)
    for id, data in pairs(RegisteredScripts) do
        if data.GuiObject and data.GuiObject.Parent then
            local nameLower = string.lower(data.Name or "")
            local catLower = string.lower(data.Category or "")
            
            local score = 0
            if filterText == "" then
                score = 1 -- Mostra todos
            else
                -- Pontuação para busca inteligente
                if nameLower == filterText then score = 100 -- Match exato no nome
                elseif string.find(nameLower, filterText, 1, true) then score = 50 -- Match parcial no nome
                elseif catLower == filterText then score = 40 -- Match exato na categoria
                elseif string.find(catLower, filterText, 1, true) then score = 20 -- Match parcial na categoria
                end
            end

            if score > 0 then
                table.insert(results, {id = id, data = data, score = score})
            end
        end
    end

    -- Ordena os resultados (Maior pontuação primeiro)
    table.sort(results, function(a, b)
        return a.score > b.score
    end)

    -- Renderiza os resultados na tela
    local layoutOrder = 1
    for _, result in ipairs(results) do
        local id = result.id
        local data = result.data
        local isFirst = (layoutOrder == 1) -- Usado para o brilho na borda

        local ItemFrame = Instance.new("Frame")
        ItemFrame.Name = "Item_" .. id
        ItemFrame.Size = UDim2.new(1, -10, 0, 50) -- Mais alto para design
        ItemFrame.Position = UDim2.new(0, 5, 0, 0)
        ItemFrame.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
        ItemFrame.BorderSizePixel = 1
        ItemFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
        ItemFrame.LayoutOrder = layoutOrder
        ItemFrame.Parent = UIListFrame

        -- [NOVO] Efeito de Brilho na borda do primeiro item (como na imagem)
        if isFirst then
            local glowStroke = Instance.new("UIStroke")
            glowStroke.Color = Color3.fromRGB(255, 255, 255)
            glowStroke.Thickness = 3
            glowStroke.Transparency = 0.3
            glowStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            glowStroke.Parent = ItemFrame
        end

        local ItemSun = Instance.new("ImageLabel")
        ItemSun.Size = UDim2.new(0, 20, 0, 20)
        ItemSun.Position = UDim2.new(0, 10, 0.5, -10)
        ItemSun.BackgroundTransparency = 1
        ItemSun.Image = "rbxassetid://77667780640343"
        ItemSun.Parent = ItemFrame

        local TextsHolder = Instance.new("Frame")
        TextsHolder.Size = UDim2.new(0.6, -30, 1, 0)
        TextsHolder.Position = UDim2.new(0, 35, 0, 0)
        TextsHolder.BackgroundTransparency = 1
        TextsHolder.Parent = ItemFrame

        local NameLabel = Instance.new("TextLabel")
        NameLabel.Size = UDim2.new(1, 0, 0, 22)
        NameLabel.Position = UDim2.new(0, 0, 0, 8)
        NameLabel.BackgroundTransparency = 1
        NameLabel.Text = data.Name or id
        NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        NameLabel.Font = Enum.Font.GothamBold -- Fonte mais grossa
        NameLabel.TextSize = 14
        NameLabel.TextXAlignment = Enum.TextXAlignment.Left
        NameLabel.TextTruncate = Enum.TextTruncate.AtEnd
        NameLabel.Parent = TextsHolder

        local SubLabel = Instance.new("TextLabel")
        SubLabel.Size = UDim2.new(1, 0, 0, 16)
        SubLabel.Position = UDim2.new(0, 0, 0, 26)
        SubLabel.BackgroundTransparency = 1
        SubLabel.Text = data.Category or "SPWN"
        SubLabel.TextColor3 = Color3.fromRGB(150, 150, 160)
        SubLabel.Font = Enum.Font.Gotham
        SubLabel.TextSize = 10
        SubLabel.TextXAlignment = Enum.TextXAlignment.Left
        SubLabel.TextTruncate = Enum.TextTruncate.AtEnd
        SubLabel.Parent = TextsHolder

        local ToggleBtn = Instance.new("TextButton")
        ToggleBtn.Size = UDim2.new(0, 60, 0, 24)
        ToggleBtn.Position = UDim2.new(1, -70, 0.5, -12)
        ToggleBtn.Font = Enum.Font.GothamBold
        ToggleBtn.TextSize = 10
        ToggleBtn.BorderSizePixel = 1

        local BtnCorner = Instance.new("UICorner")
        BtnCorner.CornerRadius = UDim.new(1, 0)
        BtnCorner.Parent = ToggleBtn

        local function updateToggleVisual()
            if data.IsVisible then
                ToggleBtn.Text = "Visível"
                ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                ToggleBtn.BorderColor3 = Color3.fromRGB(255, 255, 255)
                ToggleBtn.TextColor3 = Color3.fromRGB(10, 10, 12)
            else
                ToggleBtn.Text = "Oculto"
                ToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
                ToggleBtn.BorderColor3 = Color3.fromRGB(150, 150, 160)
                ToggleBtn.TextColor3 = Color3.fromRGB(150, 150, 160)
            end
        end

        updateToggleVisual()

        ToggleBtn.MouseButton1Click:Connect(function()
            data.IsVisible = not data.IsVisible
            WritePersistedVisibility(data.GuiObject, data.IsVisible)
            ApplyGuiVisibility(data.GuiObject, data.IsVisible)
            updateToggleVisual()
        end)
        ToggleBtn.Parent = ItemFrame

        -- Duplo clique para encerrar totalmente
        local lastClick = 0
        ItemFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                local now = os.clock()
                if now - lastClick < 0.35 then
                    local cid = id
                    task.defer(function()
                        local entry = RegisteredScripts[cid]
                        if entry then
                            if entry.OnDestroy then pcall(entry.OnDestroy) end
                            if entry.GuiObject then entry.GuiObject:Destroy() end
                            RegisteredScripts[cid] = nil
                        end
                        RefreshList()
                    end)
                end
                lastClick = now
            end
        end)

        layoutOrder = layoutOrder + 1
    end
end

-- =========================================================
-- Criação da UI (Design Melhorado e Arrastável)
